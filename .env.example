# Скопируйте в .env.local и вставьте значения

# Ключ Anthropic API (console.anthropic.com -> API Keys) — нужен для страницы /chat
ANTHROPIC_API_KEY=

# Строка подключения к Postgres — нужна для хранения броней (заменяет старый JSON-файл).
# Быстрый бесплатный вариант: создать проект на supabase.com или neon.tech и
# скопировать "Connection string" (URI / pooling). Таблица создаётся автоматически
# при первом обращении к API, вручную мигрировать не нужно.
# Пример: postgresql://user:password@host:5432/dbname
DATABASE_URL=
